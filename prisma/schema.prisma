
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserAccessToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  number    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz
  reminders Reminder[]
  greetingHistory GreetingHistory[]
  sessionLogs     SessionLog[]   
  usageSummary    UserUsageSummary? 
  conversationSummaries ConversationSummary[]

}

model AdminAccessToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  role      String   @default("ADMIN") // MAIN_ADMIN or ADMIN
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  
  // Permissions
  canManageUsers           Boolean @default(false)
  canCreateTokens          Boolean @default(false)
  canDeleteTokens          Boolean @default(false)
  canEditAdmin             Boolean @default(false)
  canAccessMemoryEditor    Boolean @default(false)
  canAccessPersonalisedConfig Boolean @default(false)
}

model AdminAccountPassword {
  id                          Int       @id @default(autoincrement())
  role                        String    // MAIN_ADMIN
  email                       String    @unique @default("kontakt@seniorenassistenz-henning.de")
  passwordHash                String
  resetPasswordToken          String?
  resetPasswordTokenExpiresAt DateTime?
  isActive                    Boolean   @default(true)
  createdAt                   DateTime  @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  role      String   // "user" or "ai"
  text      String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  updatedAt DateTime  @default(now())
  messages  Message[]
}

model MemorySummaryItem {
  id          Int      @id @default(autoincrement())
  category    String
  key         String
  value       String
  lastUpdated DateTime @default(now())
  memorySummaryId Int
  memorySummary   MemorySummary @relation(fields: [memorySummaryId], references: [id], onDelete: Cascade)
}

model MemorySummary {
  id        Int                 @id @default(autoincrement())
  token     String              @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @default(now())
  summary   MemorySummaryItem[]
}

model ConversationSummary {
  id        Int      @id @default(autoincrement())
  userToken String   @map("user_token")
  summary   String   // GPT-generated summary of the session
  sessionAt DateTime @default(now()) @map("session_at") @db.Timestamptz

  user UserAccessToken @relation(fields: [userToken], references: [token])
  @@map("conversation_summaries")
}

model PersonalityConfig {
  id                      Int      @id @default(autoincrement())
  userToken               String   @unique
  avatarUrl               String? @map("avatar_url")
  voiceId                 String?
  speakingSpeed           String   @default("normal") // "slow", "normal", "fast"
  empathyLevel            String   @default("medium") // "low", "medium", "high"
  activePrompting         Boolean  @default(true)
  reminderOffers          Boolean  @default(true)
  reengageAfterSilence    Boolean  @default(true)
  expertise               String   @default("general") // "general", "psychology", "meditation", "productivity", "coaching", "therapy"
  
  // Personality traits
  calm                    Boolean  @default(true)
  humorous                Boolean  @default(false)
  supportive              Boolean  @default(true)
  direct                  Boolean  @default(false)
  
  // Conversation guidelines (stored as JSON string or array)
  conversationGuidelines  String[] @default([])
  
  isActive                Boolean  @default(true)
  updatedBy               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Reminder {
  id                        Int                   @id @default(autoincrement())
  userToken                 String                @map("user_token")
  
  // Relations
  user                      UserAccessToken       @relation(fields: [userToken], references: [token])
  deliveryLogs              ReminderDeliveryLog[]

  // Content
  title                     String
  description               String?
  reminderType              String?               @map("reminder_type") @db.VarChar(50)
  
  // Timing
  eventDatetime             DateTime?             @map("event_datetime") @db.Timestamptz
  remindFrom                DateTime?             @map("remind_from") @db.Timestamptz
  remindUntil               DateTime?             @map("remind_until") @db.Timestamptz
  recurrence                String                @default("none") @db.VarChar(50)
  
  // Status & Tracking
  status                    String                @default("active") @db.VarChar(30)
  acknowledgedAt            DateTime?             @map("acknowledged_at") @db.Timestamptz
  timesReminded             Int                   @default(0) @map("times_reminded")
  maxRemindersPerSession    Int                   @default(1) @map("max_reminders_per_session")
  
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  @@map("reminders")
}

model ReminderDeliveryLog {
  id               Int       @id @default(autoincrement())
  reminderId       Int       @map("reminder_id")
  userToken        String    @map("user_token")
  
  // Relations
  reminder         Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  // Delivery Details
  sessionId        String    @map("session_id")
  deliveredAt      DateTime  @default(now()) @map("delivered_at") @db.Timestamptz
  deliveryStatus   String?   @map("delivery_status") @db.VarChar(30) // 'delivered', 'acknowledged'
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz

  @@map("reminder_delivery_log")
}

model GreetingHistory {
  id        Int      @id @default(autoincrement())
  userToken String   @map("user_token")
  text      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user UserAccessToken @relation(fields: [userToken], references: [token])

  @@map("greeting_history")
}

model SessionLog {
  id                    Int      @id @default(autoincrement())
  userToken             String   @map("user_token")
  sessionId             String   @unique @map("session_id")
  startedAt             DateTime @map("started_at") @db.Timestamptz
  endedAt               DateTime? @map("ended_at") @db.Timestamptz
  durationSeconds       Int      @default(0) @map("duration_seconds")

  // Realtime GPT usage
  realtimeTextInputTokens   Int   @default(0) @map("realtime_text_input_tokens")
  realtimeAudioInputTokens  Int   @default(0) @map("realtime_audio_input_tokens")
  realtimeCachedInputTokens Int   @default(0) @map("realtime_cached_input_tokens")
  realtimeCachedAudioInputTokens Int @default(0) @map("realtime_cached_audio_input_tokens")
  realtimeOutputTokens      Int   @default(0) @map("realtime_output_tokens")
  
  whisperSeconds                 Int @default(0) @map("whisper_seconds")

  // Chat completion usage (greeting + facts/reminders)
  chatInputTokens       Int      @default(0) @map("chat_input_tokens")
  chatOutputTokens      Int      @default(0) @map("chat_output_tokens")

  // ElevenLabs usage
  realtimeAudioChars    Int      @default(0) @map("realtime_audio_chars")
  greetingAudioChars    Int      @default(0) @map("greeting_audio_chars")

  // Costs in USD
  realtimeGptCost       Float    @default(0) @map("realtime_gpt_cost")
  chatGptCost           Float    @default(0) @map("chat_gpt_cost")
  elevenlabsCost        Float    @default(0) @map("elevenlabs_cost")
  totalCost             Float    @default(0) @map("total_cost")

  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  user                  UserAccessToken @relation(fields: [userToken], references: [token])

  @@map("session_logs")
}

model UserUsageSummary {
  id                    Int      @id @default(autoincrement())
  userToken             String   @unique @map("user_token")
  totalSessions         Int      @default(0) @map("total_sessions")
  totalDurationSeconds  Int      @default(0) @map("total_duration_seconds")
  totalRealtimeTextInputTokens   Int @default(0) @map("total_realtime_text_input_tokens")
  totalRealtimeAudioInputTokens  Int @default(0) @map("total_realtime_audio_input_tokens")
  totalRealtimeCachedInputTokens Int @default(0) @map("total_realtime_cached_input_tokens")
  totalRealtimeCachedAudioInputTokens Int @default(0) @map("total_realtime_cached_audio_input_tokens")
  totalRealtimeOutputTokens Int  @default(0) @map("total_realtime_output_tokens")
  totalChatInputTokens  Int      @default(0) @map("total_chat_input_tokens")
  totalWhisperSeconds                 Int @default(0) @map("total_whisper_seconds")
  totalChatOutputTokens Int      @default(0) @map("total_chat_output_tokens")
  totalRealtimeAudioChars Int    @default(0) @map("total_realtime_audio_chars")
  totalGreetingAudioChars Int    @default(0) @map("total_greeting_audio_chars")
  totalCost             Float    @default(0) @map("total_cost")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  UserAccessToken @relation(fields: [userToken], references: [token])
  @@map("user_usage_summary")
}

model ProviderPricing {
  id           Int      @id @default(autoincrement())
  provider     String   // "openai_realtime" | "openai_chat" | "elevenlabs"
  priceType    String   @map("price_type") // "input_token" | "output_token" | "audio_character"
  pricePerUnit Float    @map("price_per_unit") // USD per single unit
  unitSize     Int      @default(1) @map("unit_size") // per how many units
  description  String?
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([provider, priceType])
  @@map("provider_pricing")
}

enum RecurrenceType {
  one_time
  monthly
  yearly
}

model OperationalCost {
  id          Int      @id @default(autoincrement())
  label       String   // "server", "domain" etc
  costUsd     Float    @map("cost_usd")
  recurrence  RecurrenceType @default(one_time)
  startDate   DateTime       @map("start_date") @db.Timestamptz 
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("operational_costs")
}